# ----------------------------------------------------------------------
# Microsoft Azure / Entra ID app credentials
# Create one at: https://entra.microsoft.com (free)
# Use "Accounts in any organizational directory and personal Microsoft accounts"
# ----------------------------------------------------------------------
MS_CLIENT_ID=your-application-client-id-here
MS_CLIENT_SECRET=your-client-secret-value-here
MS_TENANT=common
MS_REDIRECT_URI=http://localhost:3000/auth/callback

# Refresh token (you obtain this once by visiting /auth/start in your browser)
MS_REFRESH_TOKEN=

# Folder name in OneDrive where uploads will be stored
ONEDRIVE_FOLDER=WaiNui-Uploads

# Server port (only used for local dev)
PORT=3000
