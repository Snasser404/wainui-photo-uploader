# ----------------------------------------------------------------------
# Dropbox app credentials
# Create one at: https://www.dropbox.com/developers/apps  (free, ~3 minutes)
# ----------------------------------------------------------------------
DROPBOX_APP_KEY=your-app-key-here
DROPBOX_APP_SECRET=your-app-secret-here
DROPBOX_REDIRECT_URI=http://localhost:3000/auth/callback

# Refresh token (you obtain this once by visiting /auth/start in your browser)
DROPBOX_REFRESH_TOKEN=

# Server port (only used for local dev)
PORT=3000
